# Supabase → Project Settings → Database → Connection string → "Transaction" pooler (port 6543)
# is recommended for serverless deploys (Vercel). Use the "Session" pooler (port 5432) if you
# hit issues, or when running drizzle-kit commands locally.
DATABASE_URL=postgresql://postgres.xxxxxxxxxxxx:[YOUR-PASSWORD]@aws-0-xx-xxxx-1.pooler.supabase.com:6543/postgres

# Any random string, 32+ characters. Generate one with:
#   openssl rand -base64 32
SESSION_SECRET=replace-this-with-a-long-random-string-before-deploying

SUPABASE_REST_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_ANON_KEY=
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=
SUPABASE_JWKS_URL=